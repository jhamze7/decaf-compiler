// function with parameters, calls, if/while, unary/binary ops
int g;

def int add(int x, int y) {
    return x + y;
}

def bool ispos(int v) {
    return !(v <= 0);
}

def int main() {
    int a;
    int b;
    a = 7;
    b = add(3, 4);         // function call

    if (ispos(a - b) && (a > 0 || b > 0)) {
        g = add(a, -b);    // unary negation + call
    } else {
        g = 0;
    }

    while (g > 0 && ispos(g)) {
        g = g - 1;
        if (g == 2) { 
            continue; 
        } else { 
            break; 
        }
    }

    return g;
}
